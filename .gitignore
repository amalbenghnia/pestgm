__pycache__/
*.pyc
.venv/
.env
*.egg-info/

# ── Large regenerated datasets (too big for GitHub > 100 MB) ──
data/processed/*.csv
data/processed/training_dataset_15min.parquet
data/processed/training_dataset_cloud.csv

# ── Allow: sample CSVs + cloud parquet (small enough for GitHub) ──
!data/processed/*_sample.csv
!data/processed/training_dataset_2023.parquet

# ── Other data ──
data/external/*
data/synthetic/*
!data/*/.gitkeep

models/registry/*
!models/registry/.gitkeep

.DS_Store
.ipynb_checkpoints/
